+namespace {
+	bool testAddBaseHelperA(const char * base, const char * rel, const char * expectedResult) {
+		UriUriA baseUri;
+		UriUriA relUri;
+		UriUriA expectedUri;
+		UriUriA transformedUri;
+		const char * errorPos = NULL;
+		if (uriParseSingleUriA(&baseUri, base, &errorPos) != URI_SUCCESS) {
+			return false;
+		}
+		if (uriParseSingleUriA(&relUri, rel, &errorPos) != URI_SUCCESS) {
+			uriFreeUriMembersA(&baseUri);
+			return false;
+		}
+		if (uriParseSingleUriA(&expectedUri, expectedResult, &errorPos) != URI_SUCCESS) {
+			uriFreeUriMembersA(&baseUri);
+			uriFreeUriMembersA(&relUri);
+			return false;
+		}
+		if (uriAddBaseUriA(&transformedUri, &relUri, &baseUri) != URI_SUCCESS) {
+			uriFreeUriMembersA(&baseUri);
+			uriFreeUriMembersA(&relUri);
+			uriFreeUriMembersA(&expectedUri);
+			return false;
+		}
+		const bool equal = URI_TRUE == uriEqualsUriA(&transformedUri, &expectedUri);
+		uriFreeUriMembersA(&baseUri);
+		uriFreeUriMembersA(&relUri);
+		uriFreeUriMembersA(&expectedUri);
+		uriFreeUriMembersA(&transformedUri);
+		return equal;
+	}
+
+	bool testNormalizeSyntaxHelperA(const char * uriText, const char * expectedNormalized) {
+		UriUriA testUri;
+		UriUriA expectedUri;
+		const char * errorPos = NULL;
+		if (uriParseSingleUriA(&testUri, uriText, &errorPos) != URI_SUCCESS) {
+			return false;
+		}
+		if (uriParseSingleUriA(&expectedUri, expectedNormalized, &errorPos) != URI_SUCCESS) {
+			uriFreeUriMembersA(&testUri);
+			return false;
+		}
+		if (uriNormalizeSyntaxExA(&testUri, URI_NORMALIZE_PATH) != URI_SUCCESS) {
+			uriFreeUriMembersA(&testUri);
+			uriFreeUriMembersA(&expectedUri);
+			return false;
+		}
+		const bool equal = URI_TRUE == uriEqualsUriA(&testUri, &expectedUri);
+		uriFreeUriMembersA(&testUri);
+		uriFreeUriMembersA(&expectedUri);
+		return equal;
+	}
+}
